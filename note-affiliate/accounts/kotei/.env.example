# 固定費みなおし帖 アカウント用の設定。これを .env にコピーして埋める。
# Discord Bot は今の転職用とは別のものを作る（同じトークンを2つで使うと二重に反応する）
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# 固定費用に新しく作るチャンネルのID
DRAFT_CHANNEL_ID=
REPORT_CHANNEL_ID=
SECRETARY_CHANNEL_ID=
# 毎朝の生成・レポートの時刻（転職用と少しずらすと、ブラウザ操作が重ならない）
DAILY_TIME=07:30
DAILY_REPORT_TIME=21:10
# 新しいnoteアカウントのユーザー名（https://note.com/ の後ろ）
NOTE_USER=
CLAUDE_CMD=claude
AUTO_PUBLISH=true
# アカウントの性格
ACCOUNT_GENRE=固定費見直し
DEFAULT_PERSONA=家計を見直したい30〜40代の会社員・共働き夫婦
