# Discord Bot のトークン（Discord Developer Portal → Bot → Reset Token）
DISCORD_TOKEN=
# Botを入れたサーバーのID（サーバー名を右クリック →「サーバーIDをコピー」）
DISCORD_GUILD_ID=
# 下書きが届くチャンネルID / 投稿報告・週次レポートのチャンネルID
DRAFT_CHANNEL_ID=
REPORT_CHANNEL_ID=
# 毎朝の下書き生成時刻（日本時間, HH:MM）
DAILY_TIME=07:00
# noteのユーザー名（https://note.com/ の後ろ）
NOTE_USER=marketingtanuki
# 記事生成に使う Claude Code のコマンド（Mac mini にインストール済みのもの）
CLAUDE_CMD=claude
# 承認後に公開まで行うか（false にすると note の下書き保存で止める）
AUTO_PUBLISH=true
