# Discord Bot のトークン（note用とは別のBotを作る。Developer Portal → Bot → Reset Token）
DISCORD_TOKEN=
# Botを入れたサーバーのID（サーバー名を右クリック →「サーバーIDをコピー」）
DISCORD_GUILD_ID=
# 下書きが届くチャンネルID / 投稿報告・レポートのチャンネルID
DRAFT_CHANNEL_ID=
REPORT_CHANNEL_ID=
# 秘書と会話するチャンネルID（作らない場合は空のまま）
SECRETARY_CHANNEL_ID=
# 毎朝の下書き生成時刻（日本時間, HH:MM）
DAILY_TIME=07:00
# 毎日のレポート送信時刻（日本時間, HH:MM）
DAILY_REPORT_TIME=21:00
# 記事生成に使う Claude Code のコマンド（Mac mini にインストール済みのもの）
CLAUDE_CMD=claude
# 承認後に公開申請まで行うか（false にすると Brain の下書き保存で止める）
AUTO_PUBLISH=true
# テーマに指定が無いときの販売設定（カテゴリーは Brain にある名前。`python -m src.brain_client categories` で一覧）
DEFAULT_PRICE=980
DEFAULT_CATEGORY=ビジネス
DEFAULT_SUBCATEGORY=
# 紹介料（Brainのアフィリエイト）。0 で紹介なし、0.1〜0.5 で10〜50%
AFFILIATE_RATE=0
