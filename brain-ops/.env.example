# Discord Bot のトークン（note用とは別のBotを作る。Developer Portal → Bot → Reset Token）
DISCORD_TOKEN=
# Botを入れたサーバーのID（サーバー名を右クリック →「サーバーIDをコピー」）
DISCORD_GUILD_ID=
# 下書きが届くチャンネルID / 投稿報告・レポートのチャンネルID
DRAFT_CHANNEL_ID=
REPORT_CHANNEL_ID=
# 秘書と会話するチャンネルID（作らない場合は空のまま）
SECRETARY_CHANNEL_ID=
# 材料を送るフォーラムチャンネルのID（チャンネル作成で「フォーラム」を選ぶ）
MATERIAL_CHANNEL_ID=
# 毎朝の下書き生成時刻（日本時間, HH:MM）
DAILY_TIME=07:00
# 毎日のレポート送信時刻（日本時間, HH:MM）
DAILY_REPORT_TIME=21:00
# 記事生成に使う Claude Code のコマンド（Mac mini にインストール済みのもの）
CLAUDE_CMD=claude
# 承認後に公開申請まで行うか（false にすると Brain の下書き保存で止める）
AUTO_PUBLISH=true
# 価格の予定。「公開からの日数:円」をカンマ区切り（公開＝Brainの審査が通った日時）
PRICE_SCHEDULE=0:100,5:1980,7:2980
# カテゴリーはAIが記事に合わせて選ぶ。選べなかったときの既定値（Brainにある名前）
DEFAULT_CATEGORY=ビジネス
DEFAULT_SUBCATEGORY=
# 紹介料（Brainのアフィリエイト）。0 で紹介なし、0.1〜0.5 で10〜50%
AFFILIATE_RATE=0.5

# レビュー特典（購入者がレビューを書くと見られる）で公式LINEに案内する。LINE_URL が空なら特典なし
LINE_URL=
# 特典の名前（本文の無料部分にも「レビュー特典あり」として出る）
REVIEW_REWARD_TITLE=公式LINE限定の特典
# 特典の中身の説明（改行は \n）。空なら「公式LINEで○○をお渡ししています。」
REVIEW_REWARD_CONTENT=
# 受け取り方（{line_url} が LINE_URL に置き換わる）
REVIEW_REWARD_METHOD=下のURLから公式LINEを友だち追加して、トークで「特典」と送ってください。\n{line_url}

# サムネを作る ChatGPT（OpenAI）のAPIキー（https://platform.openai.com/api-keys）。空なら仮のサムネになる
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# high / medium / low（high ほどきれいで高い）
OPENAI_IMAGE_QUALITY=high
