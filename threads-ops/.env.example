# Discord Bot のトークン（Discord Developer Portal → Bot → Reset Token）
DISCORD_TOKEN=
# Botを入れたサーバーのID
DISCORD_GUILD_ID=
# 下書きが届くチャンネルID（アカウントごとに分けたいときは accounts.json に channel_id を書く）
DRAFT_CHANNEL_ID=
# 投稿失敗・トークン切れなどの通知チャンネルID
REPORT_CHANNEL_ID=
# 翌日分の下書きを作る時刻（日本時間, HH:MM）
DRAFT_TIME=20:00
# 投稿時刻を 0〜N 分ランダムにずらす（全アカウントが同じ分に投稿しないように）
POST_JITTER_MIN=6
# 下書き生成に使う Claude Code のコマンド
CLAUDE_CMD=claude

# Meta for Developers のアプリ（Threads API）→ 設定 → 基本 の「Threads App ID / Secret」
THREADS_APP_ID=
THREADS_APP_SECRET=
# アプリに登録したリダイレクトURL（python -m src.accounts connect を使う場合のみ必要）
THREADS_REDIRECT_URI=
