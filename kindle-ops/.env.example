# Discord Bot のトークン（Discord Developer Portal → Bot → Reset Token）。note・Brain とは別の Bot を作る
DISCORD_TOKEN=
# Botを入れたサーバーのID（サーバー名を右クリック →「サーバーIDをコピー」）
DISCORD_GUILD_ID=
# 下書きが届くチャンネルID / 出版報告・レポートのチャンネルID
DRAFT_CHANNEL_ID=
REPORT_CHANNEL_ID=
# 毎朝の下書き生成時刻（日本時間, HH:MM）
DAILY_TIME=07:00
# 毎日のレポート送信時刻（日本時間, HH:MM）
DAILY_REPORT_TIME=21:00
# 記事生成に使う Claude Code のコマンド（Mac mini にインストール済みのもの）
CLAUDE_CMD=claude

# ---- 著者（KDPに登録する名前。ペンネーム可） ----
AUTHOR_LAST=
AUTHOR_FIRST=
# 著者名のフリガナ（カタカナ）とローマ字。日本語の本では KDP の入力欄があります
AUTHOR_LAST_KANA=
AUTHOR_FIRST_KANA=
AUTHOR_LAST_ROMAJI=
AUTHOR_FIRST_ROMAJI=

# ---- 販売設定 ----
# 価格（円）。70%ロイヤリティは 250〜1,250円の範囲
PRICE_JPY=500
# KDPセレクト（Kindle Unlimited の読み放題）に登録する
KDP_SELECT=true
# 1冊の目安の文字数（章を足した合計）
BOOK_CHARS=25000
# KDPのキーワード欄1つあたりの最大文字数（KDPの画面で弾かれたら合わせて変える）
KEYWORD_MAX_CHARS=50

# 承認後に「出版」まで押すか（false にすると KDP の下書き保存で止める。最初の数冊は false で確認推奨）
AUTO_PUBLISH=false
